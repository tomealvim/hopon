generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile      Profile?
  vehicles     Vehicle[]
  wallets      Wallet[]
  
  // Rides as driver
  offeredRides Ride[]   @relation("DriverRides")
  
  // Bookings as passenger
  bookings     Booking[]
  
  // Refresh tokens
  refreshTokens RefreshToken[]
  
  otpCodes     OtpCode[]
  
  scheduleTemplates ScheduleTemplate[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   // 'email' | 'phone'
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("otp_codes")
  @@index([userId, channel])
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  username     String?  @unique
  avatarUrl    String?
  bio          String?
  contactEmail String?

  schedule       Json?
  setupCompleted Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

model Vehicle {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  brand     String
  model     String
  plate     String?  // Hashed ideally, or encrypted
  color     String?
  imageUrl  String?
  seats     Int      @default(4)
  
  features  Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rides     Ride[]
  scheduleTemplates ScheduleTemplate[]

  @@map("vehicles")
}

model Ride {
  id             String    @id @default(uuid())
  driverId       String
  driver         User      @relation("DriverRides", fields: [driverId], references: [id])
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  
  origin         String
  destination    String
  departureTime  DateTime
  
  availableSeats Int
  price          Float?    // (SQLite: Float)
  
  status         String    @default("SCHEDULED") // (SQLite: String)
  
  scheduleTemplateId String? // Template que originou esta boleia (opcional)
  scheduleTemplate   ScheduleTemplate? @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  
  bookings       Booking[]
  
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("rides")
}

model ScheduleTemplate {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  origin         String
  destination    String
  time           String    // Hora de partida em formato "HH:mm" (ex: "08:00")
  daysOfWeek     Json      // array: ["segunda","terca",...]
  
  availableSeats Int       @default(3)
  price          Float?    // (SQLite: Float)
  
  acceptDetours  Boolean   @default(true)
  detourMaxMin   Int       @default(10)
  meetingPoint   String?
  notes          String?
  preferences    Json?     // { musica, falar, bagagem, animais }
  
  active         Boolean   @default(true)
  
  rides          Ride[]    // Boleias criadas a partir deste template
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("schedule_templates")
  @@index([userId])
  @@index([active])
}

model Booking {
  id        String        @id @default(uuid())
  rideId    String
  ride      Ride          @relation(fields: [rideId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  
  seats     Int           @default(1)
  status    String        @default("PENDING") // (SQLite: String)
  
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("bookings")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  balance   Float    @default(0) // (SQLite: Float)
  currency  String   @default("EUR")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // Hash do token (não guardar token em plain text)
  tokenId   String   @unique // JTI do token para lookup rápido
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
  @@index([userId])
  @@index([tokenHash])
}
