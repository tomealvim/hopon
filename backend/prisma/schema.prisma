generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  isIdentityVerified Boolean   @default(false)
  isAdmin            Boolean   @default(false)
  suspendedAt        DateTime?
  suspensionReason   String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile      Profile?
  vehicles     Vehicle[]
  wallets      Wallet[]
  
  // Rides as driver
  offeredRides Ride[]   @relation("DriverRides")
  
  // Bookings as passenger
  bookings     Booking[]
  
  // Refresh tokens
  refreshTokens RefreshToken[]
  
  otpCodes     OtpCode[]
  
  scheduleTemplates ScheduleTemplate[]

  conversations ConversationParticipant[]
  sentMessages  Message[]

  ratingsGiven    Rating[] @relation("ReviewsGiven")
  ratingsReceived Rating[] @relation("ReviewsReceived")

  reportsGiven    Report[] @relation("ReportsGiven")
  reportsReceived Report[] @relation("ReportsReceived")

  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   // 'email' | 'phone'
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("otp_codes")
  @@index([userId, channel])
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  username     String?  @unique
  avatarUrl    String?
  bio          String?
  contactEmail String?

  schedule       Json?
  setupCompleted Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

model Vehicle {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  brand     String
  model     String
  plate     String?  // Hashed ideally, or encrypted
  color     String?
  imageUrl  String?
  seats     Int      @default(4)
  
  features  Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rides     Ride[]
  scheduleTemplates ScheduleTemplate[]

  @@map("vehicles")
}

model Location {
  id      String  @id @default(uuid())
  label   String
  lat     Float?
  lng     Float?
  placeId String? // Google Places ID (para integração futura)
  city    String?
  campus  String?

  ridesAsOrigin      Ride[] @relation("OriginLocation")
  ridesAsDestination Ride[] @relation("DestinationLocation")

  @@map("locations")
}

model Ride {
  id             String    @id @default(uuid())
  driverId       String
  driver         User      @relation("DriverRides", fields: [driverId], references: [id])
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])

  origin         String
  destination    String
  departureTime  DateTime

  // Geodata estruturada (opcional — preenchida quando há coordenadas)
  originLocationId      String?
  destinationLocationId String?
  originLocation        Location? @relation("OriginLocation", fields: [originLocationId], references: [id], onDelete: SetNull)
  destinationLocation   Location? @relation("DestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)

  availableSeats Int
  price          Float?

  status         String    @default("SCHEDULED")

  scheduleTemplateId String?
  scheduleTemplate   ScheduleTemplate? @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)

  bookings       Booking[]
  conversations Conversation[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("rides")
}

model ScheduleTemplate {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  origin         String
  destination    String
  time           String    // Hora de partida em formato "HH:mm" (ex: "08:00")
  daysOfWeek     Json      // array: ["segunda","terca",...]
  
  availableSeats Int       @default(3)
  price          Float?
  
  acceptDetours  Boolean   @default(true)
  detourMaxMin   Int       @default(10)
  meetingPoint   String?
  notes          String?
  preferences    Json?     // { musica, falar, bagagem, animais }
  
  active         Boolean   @default(true)
  
  rides          Ride[]    // Boleias criadas a partir deste template
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("schedule_templates")
  @@index([userId])
  @@index([active])
}

model Booking {
  id        String        @id @default(uuid())
  rideId    String
  ride      Ride          @relation(fields: [rideId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  
  seats     Int           @default(1)
  status    String        @default("PENDING")

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  conversation  Conversation?
  ratings Rating[]

  @@map("bookings")
}

model Conversation {
  id           String    @id @default(uuid())
  rideId       String?
  bookingId    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ride         Ride?                    @relation(fields: [rideId], references: [id], onDelete: SetNull)
  booking      Booking?                 @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  type           String       @default("text")
  metadata       Json?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("messages")
  @@index([conversationId, createdAt])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  currency  String   @default("EUR")

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String   // CREDIT | DEBIT | REFUND | PAYOUT
  amount      Float
  reference   String?  // bookingId, rideId, etc.
  description String?
  createdAt   DateTime @default(now())

  @@map("wallet_transactions")
  @@index([walletId, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // Hash do token (não guardar token em plain text)
  tokenId   String   @unique // JTI do token para lookup rápido
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
  @@index([userId])
  @@index([tokenHash])
}

model Rating {
  id         String   @id @default(uuid())
  bookingId  String
  reviewerId String
  revieweeId String
  score      Int
  tags       Json?
  comment    String?
  createdAt  DateTime @default(now())

  booking    Booking  @relation(fields: [bookingId], references: [id])
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([bookingId, reviewerId])
  @@map("ratings")
  @@index([revieweeId])
}

model Report {
  id       String   @id @default(uuid())
  userId   String
  targetId String
  reason   String   // INAPPROPRIATE_BEHAVIOR | NO_SHOW | FRAUD | HARASSMENT | OTHER
  details  String?
  status   String   @default("PENDING") // PENDING | REVIEWED | DISMISSED

  reporter User @relation("ReportsGiven", fields: [userId], references: [id], onDelete: Cascade)
  target   User @relation("ReportsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reports")
  @@index([targetId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // booking.new | booking.confirmed | booking.declined | booking.cancelled | message.new | ride.cancelled
  title     String
  body      String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
  @@index([userId, createdAt])
  @@index([userId, read])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
  @@index([userId])
}
