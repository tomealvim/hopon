generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  isIdentityVerified Boolean   @default(false)
  isAdmin            Boolean   @default(false)
  suspendedAt        DateTime?
  suspensionReason   String?
  lateCancelCount       Int       @default(0)   // cancelamentos de última hora (<2h) no período atual
  lateCancelWindowStart DateTime?               // início da janela de 30 dias para lateCancelCount

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile      Profile?
  vehicles     Vehicle[]
  wallets      Wallet[]
  
  // Rides as driver
  offeredRides Ride[]   @relation("DriverRides")
  
  // Bookings as passenger
  bookings     Booking[]
  
  // Refresh tokens
  refreshTokens RefreshToken[]
  
  otpCodes     OtpCode[]
  
  scheduleTemplates ScheduleTemplate[]

  conversations ConversationParticipant[]
  sentMessages  Message[]

  ratingsGiven    Rating[] @relation("ReviewsGiven")
  ratingsReceived Rating[] @relation("ReviewsReceived")

  reportsGiven    Report[] @relation("ReportsGiven")
  reportsReceived Report[] @relation("ReportsReceived")

  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  passengerPolicyAcceptedAt DateTime?
  driverPolicyAcceptedAt    DateTime?

  identityDocumentUrl    String?
  identityDocumentType   String?
  identityDocumentStatus String?  @default("NONE")

  driverLicenseUrl      String?
  driverLicenseStatus   String?  @default("NONE")  // NONE | PENDING | APPROVED | REJECTED
  driverLicenseCcNumber String?  // nº CC visível na carta (para cruzar identidades)
  driverLicenseAdminNote String? // nota do admin em caso de rejeição

  openedDisputes Dispute[] @relation("OpenedDisputes")
  payoutRequests PayoutRequest[]
  userRoutes     UserRoute[]
  rideRequests       RideRequest[]
  recurringBookings  RecurringBooking[]
  driverArrangements    RecurringArrangement[] @relation("DriverArrangements")
  passengerArrangements RecurringArrangement[] @relation("PassengerArrangements")

  googleId String? @unique

  ownedCommunities  Community[]       @relation("CommunityOwner")
  communityMemberships CommunityMember[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   // 'email' | 'phone'
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("otp_codes")
  @@index([userId, channel])
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  username     String?  @unique
  avatarUrl    String?
  bio          String?
  contactEmail String?

  schedule       Json?
  setupCompleted Boolean  @default(false)

  homeAddress    String?
  homeLat        Float?
  homeLng        Float?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

model Vehicle {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  brand     String
  model     String
  plate     String?  // Hashed ideally, or encrypted
  color     String?
  imageUrl  String?
  seats     Int      @default(4)

  features       Json?
  fuelType       String?  // "gasolina95" | "gasoleo" | "gpl" | "eletrico" | "hibrido"
  avgConsumption Float?   // L/100km (ou kWh/100km para elétrico)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rides     Ride[]
  scheduleTemplates ScheduleTemplate[]

  @@map("vehicles")
}

model Location {
  id      String  @id @default(uuid())
  label   String
  lat     Float?
  lng     Float?
  placeId String? // Google Places ID (para integração futura)
  city    String?

  ridesAsOrigin      Ride[] @relation("OriginLocation")
  ridesAsDestination Ride[] @relation("DestinationLocation")

  @@map("locations")
}

model Ride {
  id             String    @id @default(uuid())
  driverId       String
  driver         User      @relation("DriverRides", fields: [driverId], references: [id])
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])

  origin         String
  destination    String
  departureTime  DateTime

  // Geodata estruturada (opcional — preenchida quando há coordenadas)
  originLocationId      String?
  destinationLocationId String?
  originLocation        Location? @relation("OriginLocation", fields: [originLocationId], references: [id], onDelete: SetNull)
  destinationLocation   Location? @relation("DestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)

  availableSeats Int
  price          Float?

  routeDistanceKm  Float?
  routeDurationMin Int?
  routeTollCost    Float?
  platformFee      Float?
  routePolyline    Json?    // array de {lat,lng} — calculado via Google Directions na criação
  instantBooking   Boolean  @default(false) // reserva auto-confirmada se passageiro estiver na rota
  meetingPoint     String?  // ponto de encontro definido pelo condutor

  status         String    @default("SCHEDULED")

  arrivedAt      DateTime?   // condutor marcou chegada ao ponto de encontro
  onTheWayAt     DateTime?   // condutor anunciou que está a caminho
  cancelledAt    DateTime?   // quando foi cancelada (soft-delete)

  scheduleTemplateId String?
  scheduleTemplate   ScheduleTemplate? @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)

  bookings       Booking[]
  conversations Conversation[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("rides")
}

model ScheduleTemplate {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  origin         String
  destination    String
  time           String    // Hora de partida em formato "HH:mm" (ex: "08:00")
  daysOfWeek     Json      // array: ["segunda","terca",...]
  
  availableSeats Int       @default(3)
  price          Float?
  
  acceptDetours  Boolean   @default(true)
  detourMaxMin   Int       @default(10)
  meetingPoint   String?
  notes          String?
  preferences    Json?     // { musica, falar, bagagem, animais }
  
  active         Boolean   @default(true)

  rides              Ride[]    // Boleias criadas a partir deste template
  recurringBookings  RecurringBooking[]
  arrangements       RecurringArrangement[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("schedule_templates")
  @@index([userId])
  @@index([active])
}

model Booking {
  id        String        @id @default(uuid())
  rideId    String
  ride      Ride          @relation(fields: [rideId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  
  seats     Int           @default(1)
  status    String        @default("PENDING")

  paymentMethod         String  @default("WALLET") // WALLET | STRIPE
  stripePaymentIntentId String? @unique

  pickupLat    Float?  // coordenadas do ponto de embarque do passageiro (opcional)
  pickupLng    Float?
  detourMeters Int?    // distância do ponto de embarque à rota do condutor (calculada no booking)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  conversation  Conversation?
  ratings Rating[]
  disputes      Dispute[]

  @@map("bookings")
}

model Conversation {
  id           String    @id @default(uuid())
  rideId       String?
  bookingId    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ride         Ride?                    @relation(fields: [rideId], references: [id], onDelete: SetNull)
  booking      Booking?                 @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  type           String       @default("text")
  metadata       Json?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("messages")
  @@index([conversationId, createdAt])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  currency  String   @default("EUR")

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String   // CREDIT | DEBIT | REFUND | PAYOUT
  amount      Float
  reference   String?  // bookingId, rideId, etc.
  description String?
  createdAt   DateTime @default(now())

  @@map("wallet_transactions")
  @@index([walletId, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // Hash do token (não guardar token em plain text)
  tokenId   String   @unique // JTI do token para lookup rápido
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
  @@index([userId])
  @@index([tokenHash])
}

model Rating {
  id         String   @id @default(uuid())
  bookingId  String
  reviewerId String
  revieweeId String
  score      Int
  tags       Json?
  comment    String?
  createdAt  DateTime @default(now())

  booking    Booking  @relation(fields: [bookingId], references: [id])
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([bookingId, reviewerId])
  @@map("ratings")
  @@index([revieweeId])
}

model Report {
  id       String   @id @default(uuid())
  userId   String
  targetId String
  reason   String   // INAPPROPRIATE_BEHAVIOR | NO_SHOW | FRAUD | HARASSMENT | OTHER
  details  String?
  status   String   @default("PENDING") // PENDING | REVIEWED | DISMISSED

  reporter User @relation("ReportsGiven", fields: [userId], references: [id], onDelete: Cascade)
  target   User @relation("ReportsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reports")
  @@index([targetId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // booking.new | booking.confirmed | booking.declined | booking.cancelled | message.new | ride.cancelled
  title     String
  body      String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
  @@index([userId, createdAt])
  @@index([userId, read])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
  @@index([userId])
}

model Dispute {
  id           String   @id @default(uuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id])
  openedById   String
  openedBy     User     @relation("OpenedDisputes", fields: [openedById], references: [id])
  reason       String
  description  String
  status       String   @default("OPEN")
  resolution   String?
  refundAmount Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("disputes")
  @@index([bookingId])
  @@index([status])
  @@index([openedById])
}

model UserRoute {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin         String
  originLat      Float?
  originLng      Float?
  destination    String
  destinationLat Float?
  destinationLng Float?
  departTime  String   // "HH:mm"
  daysOfWeek  Json     // ["segunda","terca",...]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_routes")
  @@index([userId])
}

model RideRequest {
  id          String   @id @default(uuid())
  passengerId String
  passenger   User     @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  origin         String
  originLat      Float?
  originLng      Float?
  destination    String
  destinationLat Float?
  destinationLng Float?

  departTime  String   // "HH:mm"
  daysOfWeek  Json     // ["segunda","terca",...]

  status    String   @default("OPEN")  // OPEN | CLOSED
  note      String?  // mensagem opcional ao condutor

  expiresAt DateTime // auto-fecha após 30 dias
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ride_requests")
  @@index([passengerId])
  @@index([status])
}

model PayoutRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  iban      String
  status    String   @default("PENDING")  // PENDING | APPROVED | PROCESSED | REJECTED
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payout_requests")
  @@index([userId])
  @@index([status])
}

model RecurringBooking {
  id                 String           @id @default(uuid())
  passengerId        String
  passenger          User             @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  scheduleTemplateId String
  scheduleTemplate   ScheduleTemplate @relation(fields: [scheduleTemplateId], references: [id], onDelete: Cascade)
  seats              Int              @default(1)
  status             String           @default("ACTIVE")  // ACTIVE | PAUSED | CANCELLED
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([passengerId, scheduleTemplateId])
  @@map("recurring_bookings")
  @@index([passengerId])
  @@index([scheduleTemplateId, status])
}

model Community {
  id               String   @id @default(uuid())
  name             String
  description      String?
  logoUrl          String?
  ownerId          String
  owner            User     @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  inviteCode       String   @unique
  requiresApproval Boolean  @default(true)
  domain           String?  // domínio de email opcional (ex: "iscte.pt")
  members          CommunityMember[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("communities")
  @@index([ownerId])
  @@index([inviteCode])
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER")   // OWNER | MEMBER
  status      String    @default("PENDING")  // PENDING | APPROVED | REJECTED
  joinedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([communityId, userId])
  @@map("community_members")
  @@index([userId])
  @@index([communityId, status])
}

model RecurringArrangement {
  id                 String            @id @default(uuid())
  driverId           String
  driver             User              @relation("DriverArrangements", fields: [driverId], references: [id], onDelete: Cascade)
  passengerId        String
  passenger          User              @relation("PassengerArrangements", fields: [passengerId], references: [id], onDelete: Cascade)
  scheduleTemplateId String
  scheduleTemplate   ScheduleTemplate  @relation(fields: [scheduleTemplateId], references: [id], onDelete: Cascade)
  status             String            @default("PENDING")  // PENDING | ACTIVE | DECLINED | ENDED
  proposedById       String            // quem propôs (driverId ou passengerId)
  note               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([driverId, passengerId, scheduleTemplateId])
  @@map("recurring_arrangements")
  @@index([driverId])
  @@index([passengerId])
}
