# JWT
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Database (Postgres - usa docker-compose.yml: postgres:postgres@localhost:5434/hopon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hopon

# Redis (usa docker-compose.yml: localhost:6379)
REDIS_URL=redis://localhost:6379

# Porta do servidor
PORT=3000

# Ambiente (development | production)
NODE_ENV=development

# URL do frontend — usada para CORS e para links em emails (ex: reset de password)
# Suporta múltiplas origens separadas por vírgulas
FRONTEND_URL=http://localhost:5173

# OTP por email (opcional em dev: se não definido, o código é impresso no console)
# Regista-te em https://resend.com e usa o domínio onboarding@resend.dev para testes
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Testes API: permite POST /auth/test/verify-email para marcar utilizadores como verificados (test-rides-bookings-advanced.js)
ALLOW_TEST_VERIFY=1

# Google Cloud Vision (verificação de documentos de identidade)
# Consola: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=

# Google Maps (geocoding, distâncias, polilinha de rota)
# Consola: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Login com Google (OAuth2)
# Consola: https://console.cloud.google.com/apis/credentials → OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Stripe (topup da wallet)
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Web Push (notificações)
# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:dev@hopon.dev

# Sentry (opcional em dev — deixa vazio para desativar)
SENTRY_DSN=

# Object storage — MinIO local (compatível com S3) para avatares e fotos
# Em produção, usar um bucket S3-compatible real
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hopon-avatars
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/hopon-avatars
