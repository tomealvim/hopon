# JWT
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Database (SQLite para dev)
DATABASE_URL=file:./dev.db

# Porta do servidor
PORT=3000

# OTP por email (opcional em dev: se não definido, o código é impresso no console)
# Regista-te em https://resend.com e usa o domínio onboarding@resend.dev para testes
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Testes API: permite POST /auth/test/verify-email para marcar utilizadores como verificados (test-rides-bookings-advanced.js)
ALLOW_TEST_VERIFY=1
