# URL base da API backend
VITE_API_URL=http://localhost:3000/api/v1

# Token público do Mapbox para autocomplete de moradas
# Obter em: https://account.mapbox.com → Create a token (scope: styles:read, geocoding)
VITE_MAPBOX_TOKEN=pk.ey...

# Google Maps — chave pública restrita a este domínio (Maps JavaScript API)
# Consola: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_KEY=

# Stripe — chave publicável (segura para expor no frontend)
# Dashboard: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
